{
  "name": "hello-hono-fullstack",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "vite build --mode client",
    "build:ssg": "tsx build.ts",
    "build": "pnpm clean && pnpm typecheck && pnpm build:server && pnpm build:client && pnpm build:ssg",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.8.0"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.19.0",
    "@hono/vite-ssg": "^0.2.0",
    "@types/node": "^26.4.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  }
}
